generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum SupportAccessStatus {
  PENDING
  APPROVED
  REVOKED
  EXPIRED
}

enum AuditActorType {
  USER
  PLATFORM_ADMIN
  SYSTEM
}

model PlatformAdmin {
  id                 String                 @id @default(uuid()) @db.Uuid
  email              String                 @unique @db.VarChar(320)
  name               String                 @db.VarChar(150)
  passwordHash       String                 @map("password_hash")
  isActive           Boolean                @default(true) @map("is_active")
  mustChangePassword Boolean                @default(false) @map("must_change_password")
  lastLoginAt        DateTime?              @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           PlatformSession[]
  supportGrants      SupportAccessGrant[]   @relation("GrantAdministrator")
  supportSessions    SupportAccessSession[]
  supportNotes       SupportNote[]

  @@map("platform_admins")
}

model PlatformSession {
  id              String        @id @default(uuid()) @db.Uuid
  platformAdminId String        @map("platform_admin_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash") @db.Char(64)
  csrfHash        String        @map("csrf_hash") @db.Char(64)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  ipAddress       String?       @map("ip_address") @db.VarChar(64)
  userAgent       String?       @map("user_agent") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId, expiresAt])
  @@map("platform_sessions")
}

model SubscriptionPlan {
  id              String                     @id @default(uuid()) @db.Uuid
  code            String                     @unique @db.VarChar(50)
  name            String                     @db.VarChar(100)
  maxBranches     Int                        @map("max_branches")
  maxUsers        Int                        @map("max_users")
  maxDevices      Int                        @default(3) @map("max_devices")
  isActive        Boolean                    @default(true) @map("is_active")
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  modules         PlanModule[]
  subscriptions   OrganizationSubscription[]
  billingVersions BillingPlanVersion[]

  @@map("subscription_plans")
}

model Module {
  id                  String               @id @default(uuid()) @db.Uuid
  key                 String               @unique @db.VarChar(80)
  name                String               @db.VarChar(100)
  description         String?
  phase               Int                  @default(1)
  isActive            Boolean              @default(true) @map("is_active")
  planModules         PlanModule[]
  organizationModules OrganizationModule[]

  @@map("modules")
}

model PlanModule {
  planId   String           @map("plan_id") @db.Uuid
  moduleId String           @map("module_id") @db.Uuid
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([planId, moduleId])
  @@map("plan_modules")
}

model Organization {
  id                    String                     @id @default(uuid()) @db.Uuid
  slug                  String                     @unique @db.VarChar(80)
  name                  String                     @db.VarChar(200)
  legalName             String?                    @map("legal_name") @db.VarChar(200)
  businessType          String?                    @map("business_type") @db.VarChar(50)
  email                 String?                    @db.VarChar(320)
  phone                 String?                    @db.VarChar(50)
  logoUrl               String?                    @map("logo_url") @db.VarChar(1000)
  status                OrganizationStatus         @default(ACTIVE)
  statusExpiresAt       DateTime?                  @map("status_expires_at") @db.Timestamptz(3)
  onboardingStep        Int                        @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime?                  @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  branches              Branch[]
  users                 User[]
  roles                 Role[]
  subscriptions         OrganizationSubscription[]
  modules               OrganizationModule[]
  businessSettings      BusinessSetting?
  paymentMethods        PaymentMethod[]
  auditLogs             AuditLog[]
  loginAttempts         LoginAttempt[]
  passwordResetTokens   PasswordResetToken[]
  supportGrants         SupportAccessGrant[]
  supportSessions       SupportAccessSession[]
  supportNotes          SupportNote[]
  idempotencyKeys       IdempotencyKey[]
  files                 FileAsset[]
  devices               OrganizationDevice[]
  approvalChallenges    ApprovalChallenge[]
  billingInvoices       BillingInvoice[]
  categories            ProductCategory[]
  products              Product[]
  orders                PosOrder[]
  registers             RegisterSession[]
  orderPayments         PosOrderPayment[]
  receipts              PosReceipt[]
  refunds               PosRefund[]
  floorTables           FloorTable[]
  kitchenStations       KitchenStation[]
  kitchenTickets        KitchenTicket[]
  kitchenOutbox         KitchenOutbox[]

  @@map("organizations")
}

model OrganizationSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  planId         String             @map("plan_id") @db.Uuid
  status         SubscriptionStatus @default(TRIALING)
  startsAt       DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?          @map("ends_at") @db.Timestamptz(3)
  graceEndsAt    DateTime?          @map("grace_ends_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("organization_subscriptions")
}

model BillingPlanVersion {
  id           String           @id @default(uuid()) @db.Uuid
  planId       String           @map("plan_id") @db.Uuid
  name         String           @db.VarChar(100)
  currency     String           @db.Char(3)
  monthlyMinor Int              @map("monthly_minor")
  maxBranches  Int              @map("max_branches")
  maxUsers     Int              @map("max_users")
  maxDevices   Int              @map("max_devices")
  graceDays    Int              @map("grace_days")
  moduleIds    String[]         @default([]) @map("module_ids") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     BillingInvoice[]

  @@index([planId, createdAt])
  @@map("billing_plan_versions")
}

model BillingInvoice {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  planVersionId  String              @map("plan_version_id") @db.Uuid
  commandId      String              @map("command_id") @db.Uuid
  requestHash    String              @map("request_hash") @db.Char(64)
  description    String
  currency       String              @db.Char(3)
  totalMinor     Int                 @map("total_minor")
  periodStart    DateTime            @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime            @map("period_end") @db.Timestamptz(3)
  graceEndsAt    DateTime            @map("grace_ends_at") @db.Timestamptz(3)
  anchorDay      Int                 @map("anchor_day")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  settlements    BillingSettlement[]
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  planVersion    BillingPlanVersion  @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  attachments    BillingAttachment[]

  @@unique([organizationId, commandId])
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@map("billing_invoices")
}

model BillingSettlement {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  invoiceId      String         @map("invoice_id") @db.Uuid
  commandId      String         @map("command_id") @db.Uuid
  requestHash    String         @map("request_hash") @db.Char(64)
  kind           String         @db.VarChar(20)
  amountMinor    Int            @map("amount_minor")
  method         String         @db.VarChar(30)
  reference      String         @db.VarChar(200)
  reason         String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  invoice        BillingInvoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, commandId])
  @@index([organizationId, invoiceId])
  @@map("billing_settlements")
}

model BillingAttachment {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  invoiceId      String         @map("invoice_id") @db.Uuid
  name           String         @db.VarChar(150)
  mimeType       String         @map("mime_type") @db.VarChar(40)
  content        Bytes
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  invoice        BillingInvoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, invoiceId])
  @@map("billing_attachments")
}

model OrganizationModule {
  organizationId String       @map("organization_id") @db.Uuid
  moduleId       String       @map("module_id") @db.Uuid
  enabled        Boolean      @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([organizationId, moduleId])
  @@map("organization_modules")
}

model Branch {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  name            String             @db.VarChar(150)
  code            String             @db.VarChar(30)
  address         String?
  phone           String?            @db.VarChar(50)
  email           String?            @db.VarChar(320)
  timezone        String             @default("Asia/Karachi") @db.VarChar(100)
  isPrimary       Boolean            @default(false) @map("is_primary")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships     BranchMembership[]
  settings        BranchSetting?
  auditLogs       AuditLog[]
  productPrices   ProductPrice[]
  orders          PosOrder[]
  registers       RegisterSession[]
  floorTables     FloorTable[]
  kitchenStations KitchenStation[]
  kitchenTickets  KitchenTicket[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, isActive])
  @@map("branches")
}

model User {
  id                         String               @id @default(uuid()) @db.Uuid
  organizationId             String               @map("organization_id") @db.Uuid
  username                   String               @db.VarChar(80)
  email                      String?              @db.VarChar(320)
  name                       String               @db.VarChar(150)
  phone                      String?              @db.VarChar(50)
  passwordHash               String               @map("password_hash")
  pinHash                    String?              @map("pin_hash")
  status                     UserStatus           @default(ACTIVE)
  mustChangePassword         Boolean              @default(true) @map("must_change_password")
  temporaryPasswordExpiresAt DateTime?            @map("temporary_password_expires_at") @db.Timestamptz(3)
  failedLoginCount           Int                  @default(0) @map("failed_login_count")
  lockedUntil                DateTime?            @map("locked_until") @db.Timestamptz(3)
  lastLoginAt                DateTime?            @map("last_login_at") @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization               Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branchMemberships          BranchMembership[]
  roles                      UserRole[]
  sessions                   Session[]
  loginAttempts              LoginAttempt[]
  passwordResetTokens        PasswordResetToken[]
  auditLogs                  AuditLog[]

  @@unique([organizationId, username])
  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("users")
}

model BranchMembership {
  organizationId String  @map("organization_id") @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  branchId       String  @map("branch_id") @db.Uuid
  isDefault      Boolean @default(false) @map("is_default")
  user           User    @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch         Branch  @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([organizationId, branchId])
  @@map("branch_memberships")
}

model Role {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  key                String           @db.VarChar(80)
  name               String           @db.VarChar(100)
  description        String?
  isSystem           Boolean          @default(false) @map("is_system")
  scope              Json             @default("{}")
  approvalLimitMinor Int?             @map("approval_limit_minor")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users              UserRole[]
  permissions        RolePermission[]

  @@unique([organizationId, key])
  @@unique([id, organizationId])
  @@map("roles")
}

model ApprovalChallenge {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  action         String       @db.VarChar(100)
  payloadHash    String       @map("payload_hash") @db.Char(64)
  amountMinor    Int?         @map("amount_minor")
  requestedById  String       @map("requested_by_id") @db.Uuid
  approvedById   String?      @map("approved_by_id") @db.Uuid
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime?    @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, action, expiresAt])
  @@map("approval_challenges")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  name        String           @db.VarChar(150)
  description String?
  moduleKey   String           @map("module_key") @db.VarChar(80)
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  user           User   @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role           Role   @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  deviceId       String?             @map("device_id") @db.Uuid
  tokenHash      String              @unique @map("token_hash") @db.Char(64)
  csrfHash       String              @map("csrf_hash") @db.Char(64)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)
  lastSeenAt     DateTime            @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime?           @map("revoked_at") @db.Timestamptz(3)
  ipAddress      String?             @map("ip_address") @db.VarChar(64)
  userAgent      String?             @map("user_agent") @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  device         OrganizationDevice? @relation(fields: [deviceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, userId, expiresAt])
  @@index([organizationId, deviceId])
  @@map("sessions")
}

model OrganizationDevice {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  deviceHash     String       @map("device_hash") @db.Char(64)
  displayName    String       @map("display_name") @db.VarChar(160)
  userAgent      String?      @map("user_agent") @db.VarChar(500)
  lastIpAddress  String?      @map("last_ip_address") @db.VarChar(64)
  firstSeenAt    DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       Session[]

  @@unique([organizationId, deviceHash])
  @@unique([id, organizationId])
  @@index([organizationId, revokedAt])
  @@map("organization_devices")
}

model LoginAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  identifier     String        @db.VarChar(320)
  successful     Boolean
  failureCode    String?       @map("failure_code") @db.VarChar(80)
  ipAddress      String?       @map("ip_address") @db.VarChar(64)
  userAgent      String?       @map("user_agent") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt         DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@map("password_reset_tokens")
}

model BusinessSetting {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @unique @map("organization_id") @db.Uuid
  countryCode      String       @default("PK") @map("country_code") @db.Char(2)
  currencyCode     String       @default("PKR") @map("currency_code") @db.Char(3)
  timezone         String       @default("Asia/Karachi") @db.VarChar(100)
  locale           String       @default("en") @db.VarChar(20)
  dateFormat       String       @default("DD-MM-YYYY") @map("date_format") @db.VarChar(30)
  accentColor      String       @default("#0f766e") @map("accent_color") @db.VarChar(20)
  taxConfig        Json         @default("{}") @map("tax_config")
  serviceConfig    Json         @default("{}") @map("service_config")
  orderTypes       Json         @default("[]") @map("order_types")
  receiptConfig    Json         @default("{}") @map("receipt_config")
  managerPinPolicy Json         @default("{}") @map("manager_pin_policy")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model BranchSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @unique @map("branch_id") @db.Uuid
  operatingHours Json     @default("{}") @map("operating_hours")
  printerConfig  Json     @default("{}") @map("printer_config")
  taxOverride    Json?    @map("tax_override")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch         Branch   @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([branchId, organizationId])
  @@index([organizationId])
  @@map("branch_settings")
}

model PaymentMethod {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String       @db.VarChar(60)
  name           String       @db.VarChar(100)
  type           String       @db.VarChar(40)
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("payment_methods")
}

model ProductCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  sortOrder      Int          @default(0) @map("sort_order")
  isActive       Boolean      @default(true) @map("is_active")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@map("product_categories")
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  categoryId     String?          @map("category_id") @db.Uuid
  name           String           @db.VarChar(180)
  sku            String?          @db.VarChar(80)
  barcode        String?          @db.VarChar(120)
  taxRateBps     Int              @default(0) @map("tax_rate_bps")
  isActive       Boolean          @default(true) @map("is_active")
  isCombo        Boolean          @default(false) @map("is_combo")
  comboItems     Json             @default("[]") @map("combo_items")
  modifierConfig Json             @default("[]") @map("modifier_config")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  prices         ProductPrice[]
  orderItems     PosOrderItem[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@map("products")
}

model ProductVariant {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  name           String         @db.VarChar(120)
  priceMinor     Int            @map("price_minor")
  isActive       Boolean        @default(true) @map("is_active")
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     PosOrderItem[]

  @@unique([productId, name])
  @@map("product_variants")
}

model ProductPrice {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  branchId       String  @map("branch_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  priceMinor     Int     @map("price_minor")
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch         Branch  @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([branchId, productId])
  @@map("product_prices")
}

model RegisterSession {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  branchId          String       @map("branch_id") @db.Uuid
  openedById        String       @map("opened_by_id") @db.Uuid
  openingFloatMinor Int          @map("opening_float_minor")
  openedAt          DateTime     @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt          DateTime?    @map("closed_at") @db.Timestamptz(3)
  closingTotalMinor Int?         @map("closing_total_minor")
  branch            Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orders            PosOrder[]

  @@index([organizationId, branchId, closedAt])
  @@map("register_sessions")
}

model PosOrder {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid
  registerId     String?           @map("register_id") @db.Uuid
  createdById    String            @map("created_by_id") @db.Uuid
  orderNumber    Int               @default(autoincrement()) @map("order_number")
  orderType      String            @default("TAKEAWAY") @map("order_type") @db.VarChar(30)
  status         String            @default("PAID") @db.VarChar(30)
  subtotalMinor  Int               @map("subtotal_minor")
  taxMinor       Int               @map("tax_minor")
  totalMinor     Int               @map("total_minor")
  taxMode        String            @default("EXCLUSIVE") @map("tax_mode") @db.VarChar(20)
  discountMinor  Int               @default(0) @map("discount_minor")
  paidMinor      Int               @default(0) @map("paid_minor")
  changeMinor    Int               @default(0) @map("change_minor")
  refundedMinor  Int               @default(0) @map("refunded_minor")
  tableId        String?           @map("table_id") @db.Uuid
  version        Int               @default(1)
  serviceStatus  String            @default("DRAFT") @map("service_status") @db.VarChar(30)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  branch         Branch            @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  register       RegisterSession?  @relation(fields: [registerId], references: [id], onDelete: SetNull)
  table          FloorTable?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items          PosOrderItem[]
  payments       PosOrderPayment[]
  receipt        PosReceipt?
  refunds        PosRefund[]
  tickets        KitchenTicket[]

  @@unique([organizationId, orderNumber])
  @@map("pos_orders")
}

model FloorTable {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  name           String       @db.VarChar(80)
  capacity       Int          @default(2)
  status         String       @default("AVAILABLE") @db.VarChar(20)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orders         PosOrder[]

  @@unique([organizationId, branchId, name])
  @@unique([id, organizationId, branchId])
  @@index([organizationId, branchId, status])
  @@map("floor_tables")
}

model KitchenStation {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  branchId       String          @map("branch_id") @db.Uuid
  name           String          @db.VarChar(100)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tickets        KitchenTicket[]

  @@unique([organizationId, branchId, name])
  @@unique([id, organizationId, branchId])
  @@map("kitchen_stations")
}

model KitchenTicket {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  branchId       String          @map("branch_id") @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  stationId      String          @map("station_id") @db.Uuid
  sequence       Int
  kind           String          @default("INITIAL") @db.VarChar(20)
  status         String          @default("PENDING") @db.VarChar(20)
  version        Int             @default(1)
  items          Json
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  readyAt        DateTime?       @map("ready_at") @db.Timestamptz(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order          PosOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  station        KitchenStation  @relation(fields: [stationId], references: [id], onDelete: Restrict)
  outbox         KitchenOutbox[]

  @@unique([organizationId, orderId, sequence])
  @@index([organizationId, branchId, stationId, status])
  @@map("kitchen_tickets")
}

model KitchenOutbox {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  ticketId       String        @map("ticket_id") @db.Uuid
  eventType      String        @map("event_type") @db.VarChar(50)
  payload        Json
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt    DateTime?     @map("delivered_at") @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ticket         KitchenTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([organizationId, branchId, createdAt])
  @@map("kitchen_outbox")
}

model PosOrderItem {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  variantId      String?         @map("variant_id") @db.Uuid
  nameSnapshot   String          @map("name_snapshot") @db.VarChar(180)
  quantity       Int
  unitPriceMinor Int             @map("unit_price_minor")
  taxMinor       Int             @map("tax_minor")
  lineTotalMinor Int             @map("line_total_minor")
  modifiers      Json            @default("[]")
  order          PosOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("pos_order_items")
}

model PosOrderPayment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  method         String       @db.VarChar(40)
  amountMinor    Int          @map("amount_minor")
  reference      String?      @db.VarChar(160)
  tenderKind     String       @default("MANUAL") @map("tender_kind") @db.VarChar(20)
  verifiedAt     DateTime?    @map("verified_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order          PosOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("pos_order_payments")
}

model PosRefund {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  amountMinor    Int          @map("amount_minor")
  reason         String       @db.VarChar(500)
  disposition    String       @default("NO_STOCK") @db.VarChar(30)
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  order          PosOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([organizationId, orderId])
  @@map("pos_refunds")
}

model PosReceipt {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  orderId        String       @unique @map("order_id") @db.Uuid
  receiptNumber  String       @map("receipt_number") @db.VarChar(50)
  issuedAt       DateTime     @default(now()) @map("issued_at") @db.Timestamptz(3)
  order          PosOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, receiptNumber])
  @@map("pos_receipts")
}

model FileAsset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  objectKey      String       @unique @map("object_key") @db.VarChar(700)
  originalName   String       @map("original_name") @db.VarChar(255)
  mimeType       String       @map("mime_type") @db.VarChar(150)
  sizeBytes      BigInt       @map("size_bytes")
  checksum       String?      @db.VarChar(128)
  status         String       @default("PENDING") @db.VarChar(30)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("file_assets")
}

model SupportAccessGrant {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  platformAdminId  String                 @map("platform_admin_id") @db.Uuid
  reason           String
  status           SupportAccessStatus    @default(PENDING)
  expiresAt        DateTime               @map("expires_at") @db.Timestamptz(3)
  approvedByUserId String?                @map("approved_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  platformAdmin    PlatformAdmin          @relation("GrantAdministrator", fields: [platformAdminId], references: [id], onDelete: Restrict)
  sessions         SupportAccessSession[]

  @@index([organizationId, status, expiresAt])
  @@map("support_access_grants")
}

model SupportAccessSession {
  id              String             @id @default(uuid()) @db.Uuid
  grantId         String             @map("grant_id") @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  platformAdminId String             @map("platform_admin_id") @db.Uuid
  startedAt       DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?          @map("ended_at") @db.Timestamptz(3)
  ipAddress       String?            @map("ip_address") @db.VarChar(64)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  platformAdmin   PlatformAdmin      @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)
  grant           SupportAccessGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@index([organizationId, startedAt])
  @@map("support_access_sessions")
}

model SupportNote {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  platformAdminId String        @map("platform_admin_id") @db.Uuid
  body            String
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("support_notes")
}

model IdempotencyKey {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String       @db.VarChar(160)
  operation      String       @db.VarChar(100)
  requestHash    String       @map("request_hash") @db.Char(64)
  responseCode   Int?         @map("response_code")
  responseBody   Json?        @map("response_body")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, operation])
  @@map("idempotency_keys")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  branchId       String?        @map("branch_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  action         String         @db.VarChar(120)
  entityType     String         @map("entity_type") @db.VarChar(100)
  entityId       String?        @map("entity_id") @db.Uuid
  beforeValue    Json?          @map("before_value")
  afterValue     Json?          @map("after_value")
  reason         String?
  ipAddress      String?        @map("ip_address") @db.VarChar(64)
  userAgent      String?        @map("user_agent") @db.VarChar(500)
  correlationId  String?        @map("correlation_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorType, actorId, createdAt])
  @@map("audit_logs")
}
